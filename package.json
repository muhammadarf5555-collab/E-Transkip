{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "start": "php artisan serve",
        "start:hp": "php artisan serve --host=0.0.0.0 --port=8000",
        "online": "concurrently -k \"php artisan serve --port=8000\" \"ssh -p 443 -o StrictHostKeyChecking=no -R0:localhost:8000 a.pinggy.io\"",
        "online2": "concurrently -k \"php artisan serve --port=8000\" \"ssh -o StrictHostKeyChecking=no -R 80:localhost:8000 nokey@localhost.run\"",
        "tunnel": "concurrently -k \"php artisan serve --port=8000\" \"\\\"C:\\\\Program Files (x86)\\\\cloudflared\\\\cloudflared.exe\\\" tunnel --url http://localhost:8000\""
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
